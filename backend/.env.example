# Python FastAPI API; local PostgreSQL runs on loopback only.
PORT=3001
ENVIRONMENT=development
DATABASE_URL=postgresql://safaridesk_app:replace-me@127.0.0.1:5432/safaridesk
POSTGRES_ADMIN_PASSWORD=
SAFARIDESK_APP_DB_PASSWORD=
SAFARIDESK_MCP_DB_PASSWORD=
MCP_DATABASE_URL=postgresql://safaridesk_mcp:replace-me@127.0.0.1:5432/safaridesk

# Use at least 32 random bytes; replacing this invalidates existing access tokens.
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=2592000
PASSWORD_RESET_TTL_MINUTES=30
INVITE_TTL_DAYS=7
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3002
MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=15
AUTH_RATE_LIMIT=30

# First administrator. Set a unique password in backend/.env; no demo users are seeded.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=SafariDesk Admin

# Africa's Talking Sandbox: use the Sandbox username and sandbox API key.
# Leave AT_SENDER_ID blank in Sandbox; the backend omits the sender field.
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
AT_TEST_PHONE=
# Optional comma-separated Kenyan numbers in E.164, 254..., or 07... format.
AT_ALLOWED_PHONES=
# Quote codes containing #, for example: AT_USSD_SERVICE_CODE="*123#"
AT_USSD_SERVICE_CODE=
# Generate a random token with at least 32 bytes of entropy.
WEBHOOK_TOKEN=
# Set both to the active ngrok HTTPS origin (no trailing slash).
PUBLIC_BASE_URL=
PUBLIC_APP_URL=
AT_WEBHOOK_RATE_LIMIT=120

# Optional payment provider credentials.
PAYSTACK_SECRET_KEY=
# Set this to Paystack's generated whsec_ signing secret. When blank, the API
# accepts only the legacy X-Paystack-Signature using PAYSTACK_SECRET_KEY.
PAYSTACK_WEBHOOK_SECRET=
