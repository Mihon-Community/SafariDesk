# Auth service configuration (see backend/README.md for details)
PORT=3001
NODE_ENV=development

# Leave unset to use the in-memory auth store; set for Postgres.
# DATABASE_URL=postgres://user:pass@localhost:5432/safaridesk

JWT_SECRET=change-me-in-production
ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=2592000
PASSWORD_RESET_TTL_MINUTES=30
INVITE_TTL_DAYS=7
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
BCRYPT_ROUNDS=12
MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=15
AUTH_RATE_LIMIT=30

# Seeds the first admin on boot (idempotent).
ADMIN_EMAIL=admin@safaridesk.app
ADMIN_PASSWORD=password123
ADMIN_NAME=SafariDesk Admin

# Africa's Talking SMS / USSD (start in the Sandbox; real sends are not run by tests).
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
AT_TEST_PHONE=
# Quote the service code when setting it; dotenv treats an unquoted # as a comment.
AT_USSD_SERVICE_CODE=
# Optional comma-separated allowlist, in Kenyan E.164 format (+254...).
AT_ALLOWED_PHONES=
# Generate locally with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WEBHOOK_TOKEN=
# HTTPS origin from ngrok; the local helper forwards it to localhost:3001.
PUBLIC_BASE_URL=
# Use the frontend's local URL for development links.
PUBLIC_APP_URL=http://localhost:3002
AT_WEBHOOK_RATE_LIMIT=120
