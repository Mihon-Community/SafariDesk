# Backend origin for API calls. Empty = same origin (Express serves the built app).
NEXT_PUBLIC_API_URL=

# Socket.IO origin. Empty = same origin.
NEXT_PUBLIC_SOCKET_URL=

# MSW mock handlers for backend-free development only. Never enable in production builds.
NEXT_PUBLIC_USE_MOCKS=true

# Phase 7: with mocks off, /api/* is rewritten to this origin (cookies stay same-origin).
# BACKEND_URL=http://127.0.0.1:3001
