# Backend origin for API + Socket.IO calls. Leave empty to use the Vite dev
# proxy (/api -> http://localhost:3000) or the Express static host in production.
VITE_API_URL=

# Set to "true" ONLY for backend-free local development (MSW mock handlers).
# Production builds must leave this unset/false.
VITE_USE_MOCKS=false

# Proxy target used by `vite dev` when VITE_API_URL is empty.
VITE_PROXY_TARGET=http://localhost:3000
